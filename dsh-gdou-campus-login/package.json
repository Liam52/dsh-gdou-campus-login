{
  "name": "@local/gdou-campus-login",
  "version": "1.1.1",
  "description": "广东海洋大学校园网自动登录插件：断网自动通过深澜(srun)认证登录，软件内提供「校园网」面板（实时状态、流量用量、网络测速、选课公告、多账号切换、环境检测与一键诊断）。",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liam52/dsh-gdou-campus-login.git"
  },
  "homepage": "https://github.com/Liam52/dsh-gdou-campus-login#readme",
  "bugs": {
    "url": "https://github.com/Liam52/dsh-gdou-campus-login/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "gdou",
    "srun",
    "深澜",
    "校园网",
    "广东海洋大学"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}